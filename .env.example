# ====== Server (apps/server) ======
NODE_ENV=development
PORT=3000
# Database utama (dev) & database test (Vitest / e2e)
DATABASE_URL=postgres://pos:pos@localhost:5432/pos
TEST_DATABASE_URL=postgres://pos:pos@localhost:5432/pos_test
# Rahasia untuk tanda tangan cookie sesi (min. 32 karakter, acak)
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Lama sesi staf (jam)
SESSION_TTL_HOURS=16
# Origin web (untuk CORS & link QR)
POS_ORIGIN=http://localhost:5173
ORDER_ORIGIN=http://localhost:5174
# Zona waktu bisnis
TZ_BUSINESS=Asia/Phnom_Penh
# Antrian pg-boss (false = mati, mis. saat test)
JOBS_ENABLED=true

# ====== Telegram (kosong = mode mock/disabled) ======
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ====== Gemini AI (kosong = mode mock) ======
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ====== Google Maps (kosong = peta placeholder + input lat/lng manual) ======
GOOGLE_MAPS_API_KEY=
# Untuk frontend (Vite membaca variabel VITE_*)
VITE_GOOGLE_MAPS_API_KEY=

# ====== Cloudflare R2 (kosong = simpan ke disk lokal UPLOAD_DIR) ======
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=
R2_PUBLIC_URL=
# Fallback lokal untuk upload (foto menu, bukti bayar, foto pengeluaran)
UPLOAD_DIR=./uploads

# ====== Frontend dev proxy ======
# Target server API untuk proxy Vite (/api, /ws, /uploads)
VITE_API_TARGET=http://localhost:3000
