{
  "name": "pos-restaurant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pos/server --filter @pos/pos-web --filter @pos/order-web dev",
    "build": "pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @pos/server db:migrate",
    "db:seed": "pnpm --filter @pos/server db:seed",
    "db:generate": "pnpm --filter @pos/server db:generate",
    "db:reset": "pnpm --filter @pos/server db:reset",
    "format:check": "prettier --check .",
    "icons": "node scripts/gen-icons.mjs apps/pos-web/public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
